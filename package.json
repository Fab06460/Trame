{
  "name": "trame",
  "version": "0.1.0",
  "description": "Trame — éditeur de design hors-ligne",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "smoke": "electron-vite build && node scripts/smoke-test.mjs",
    "fidelity": "node scripts/pdf-fidelity/run.mjs",
    "release:check": "node scripts/release-mac.mjs --check",
    "release:mac": "node scripts/release-mac.mjs"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "konva": "^10.9.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "author": {
    "name": "Fabrice Belloncle",
    "email": "fabrice.belloncle@gmail.com"
  },
  "build": {
    "appId": "app.trame.editor",
    "productName": "Trame",
    "copyright": "Copyright © 2026 Fabrice Belloncle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Trame ${version}"
    },
    "fileAssociations": [
      {
        "ext": "trame",
        "name": "Projet Trame",
        "description": "Projet Trame",
        "role": "Editor",
        "icon": "build/icon.icns"
      }
    ]
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdfjs-dist": "^6.4.299"
  }
}
