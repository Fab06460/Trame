{
  "name": "trame",
  "version": "0.1.2",
  "description": "Trame — éditeur de design hors-ligne",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "smoke": "electron-vite build && node scripts/smoke-test.mjs",
    "fidelity": "node scripts/pdf-fidelity/run.mjs",
    "resize-gallery": "node scripts/pdf-fidelity/run-gallery.mjs",
    "release:check": "node scripts/release-mac.mjs --check",
    "release:mac": "node scripts/release-mac.mjs",
    "pack:win": "electron-vite build && electron-builder --win --dir",
    "dist:win": "electron-vite build && electron-builder --win",
    "pack:linux": "electron-vite build && electron-builder --linux --dir",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "konva": "^10.9.0",
    "nanoid": "^5.1.16",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "zustand": "^5.0.16"
  },
  "author": {
    "name": "Fabrice Belloncle",
    "email": "fabrice.belloncle@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fab06460/Trame.git"
  },
  "homepage": "https://github.com/Fab06460/Trame",
  "build": {
    "appId": "app.trame.editor",
    "productName": "Trame",
    "copyright": "Copyright © 2026 Fabrice Belloncle",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Trame ${version}"
    },
    "fileAssociations": [
      {
        "ext": "trame",
        "name": "Projet Trame",
        "description": "Projet Trame",
        "role": "Editor",
        "mimeType": "application/x-trame"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "synopsis": "Éditeur de design hors-ligne",
      "description": "Trame est un éditeur de design (affiches, présentations, documents) qui fonctionne entièrement hors ligne.",
      "maintainer": "Fabrice Belloncle <fabrice.belloncle@gmail.com>",
      "syncDesktopName": true
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "electron-updater": "^6.8.11",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "qrcode-generator": "^2.0.4"
  },
  "desktopName": "trame.desktop"
}
