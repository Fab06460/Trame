{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@/*": ["./src/renderer/src/*"] }
  },
  "include": ["src", "scripts/pdf-fidelity/*.ts", "electron.vite.config.ts", "vitest.config.ts"]
}
